# Normaliza los finales de línea para que el repo no genere ruido entre Windows,
# macOS y Linux. Los scripts de Windows necesitan CRLF para ejecutarse bien.

* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binarios
*.png binary
*.jpg binary
*.webp binary
*.ico binary
*.db binary
*.woff2 binary
